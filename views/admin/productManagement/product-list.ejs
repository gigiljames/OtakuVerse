<%-include("../../partials/admin-template.ejs")%>
    <title>Product Management</title>
    <link rel="stylesheet" href="/admin/productManagement/product-list.css" />
  </head>
  <body>
    <%- include('../../partials/alert.ejs') %>

    <!-- Mobile top bar -->
    <div class="mobile-topbar">
      <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Open menu">
        <span class="material-symbols-outlined">menu</span>
      </button>
      <a href="/admin" class="mobile-logo">OtakuVerse</a>
    </div>

    <!-- Sidebar overlay (mobile) -->
    <div class="sidebar-overlay" id="sidebar-overlay"></div>

    <div class="admin-layout">
      <%- include('../../partials/admin-sidebar.ejs') %>

      <main class="main-content">
        <div class="page-inner">

          <!-- Page header -->
          <div class="page-header">
            <h1 class="page-title">Products</h1>
            <button class="add-button">
              <span class="material-symbols-outlined">add</span>
              Add Product
            </button>
          </div>

          <!-- Table card -->
          <div class="table-card">
            <div class="table-wrapper">
              <table>
                <thead>
                  <tr>
                    <th>Product ID</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Visibility</th>
                    <th>Action</th>
                  </tr>
                </thead>
                <tbody>
                  <% if (productList.length === 0) { %>
                    <tr>
                      <td colspan="5" class="empty-row">No products found.</td>
                    </tr>
                  <% } else { %>
                    <% for (let i = 0; i < productList.length; i++) { %>
                      <tr class="product-row" data-href="/admin/view-product/<%= productList[i]._id %>">
                        <td class="id-col"><%= productList[i]._id %></td>
                        <td><%= productList[i].product_name %></td>
                        <td><%= productList[i].category?.category_name || 'Uncategorized' %></td>
                        <td id="visibility-<%= productList[i]._id %>">
                          <% if (productList[i].is_enabled) { %>
                            <span class="status-badge status-visible">Visible</span>
                          <% } else { %>
                            <span class="status-badge status-blocked">Blocked</span>
                          <% } %>
                        </td>
                        <td class="action-col">
                          <% if (productList[i].is_enabled) { %>
                            <button
                              class="visibility-button"
                              id="button-<%= productList[i]._id %>"
                              data-visible="true"
                              onclick="handleVisibility(event, '<%= productList[i]._id %>')">
                              Disable
                            </button>
                          <% } else { %>
                            <button
                              class="visibility-button"
                              id="button-<%= productList[i]._id %>"
                              data-visible="false"
                              onclick="handleVisibility(event, '<%= productList[i]._id %>')">
                              Enable
                            </button>
                          <% } %>
                        </td>
                      </tr>
                    <% } %>
                  <% } %>
                </tbody>
              </table>
            </div>
            <div class="pagination-wrapper">
              <!-- Inline pagination (uses pageCount + offset locals) -->
              <% if (pageCount > 0) { %>
                <div class="pagination-container">
                  <div class="pagination-buttons">
                    <a href="/admin/product-management?offset=<%= Math.max(1, parseInt(offset) - 1) %>">
                      <button>&lt; Previous</button>
                    </a>
                    <% for (let i = 1; i <= pageCount; i++) { %>
                      <a href="/admin/product-management?offset=<%= i %>">
                        <button <%= i == offset ? 'id="pagination-selected"' : '' %>><%= i %></button>
                      </a>
                    <% } %>
                    <a href="/admin/product-management?offset=<%= Math.min(pageCount, parseInt(offset) + 1) %>">
                      <button>Next &gt;</button>
                    </a>
                  </div>
                </div>
              <% } %>
            </div>
          </div>

        </div>
      </main>
    </div>

    <!-- Add Product Modal -->
    <div class="add-form-outer">
      <div class="add-form-inner">
        <div class="modal-header">
          <div class="form-title">Add Product</div>
          <button class="close-button" aria-label="Close">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        <form id="add-form" method="POST" action="/admin/add-product">
          <div class="form-grid">
            <div class="form-col">
              <div class="input-container">
                <label for="name-input">Product name</label>
                <input id="name-input" type="text" name="name" placeholder="e.g. Attack on Titan Hoodie" autocomplete="off" />
              </div>
              <div id="name-error" class="error-container"></div>

              <div class="input-container">
                <label for="price-input">Price (₹)</label>
                <input id="price-input" type="text" name="price" placeholder="e.g. 999" autocomplete="off" />
              </div>
              <div id="price-error" class="error-container"></div>

              <div class="input-container">
                <label for="visibility-input">Visibility</label>
                <select id="visibility-input" name="visibility">
                  <option value="true">Enabled</option>
                  <option value="false">Disabled</option>
                </select>
              </div>
              <div id="visibility-error" class="error-container"></div>

              <div class="input-container">
                <label for="specs-input">Product specifications</label>
                <textarea id="specs-input" name="specs" placeholder="List key specifications, one per line…"></textarea>
              </div>
              <div id="specs-error" class="error-container"></div>
            </div>

            <div class="form-col">
              <div class="input-container">
                <label for="category-input">Category</label>
                <select id="category-input" name="category">
                  <% categoryList.forEach(category => { %>
                    <option value="<%= category._id %>"><%= category.category_name %></option>
                  <% }); %>
                </select>
              </div>
              <div id="category-error" class="error-container"></div>

              <div class="input-container">
                <label for="discount-input">Discount (%)</label>
                <input id="discount-input" type="text" name="discount" placeholder="e.g. 10" autocomplete="off" />
              </div>
              <div id="discount-error" class="error-container"></div>

              <div class="input-container">
                <label for="desc-input">Product description</label>
                <textarea id="desc-input" name="desc" placeholder="Describe the product…"></textarea>
              </div>
              <div id="desc-error" class="error-container"></div>

              <input class="submit-button" type="submit" value="Add Product" />
            </div>
          </div>
        </form>
      </div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const mobileBtn = document.getElementById("mobile-menu-btn");
        const sidebarToggle = document.getElementById("sidebar-toggle");
        if (mobileBtn && sidebarToggle) {
          mobileBtn.addEventListener("click", () => sidebarToggle.click());
        }
        // Clickable rows — navigate unless the click was on the action button
        document.querySelectorAll(".product-row").forEach(row => {
          row.addEventListener("click", (e) => {
            if (!e.target.closest(".action-col")) {
              window.location.href = row.dataset.href;
            }
          });
        });
      });
    </script>
    <script src="/js/product-list.js"></script>
  </body>
</html>
