<%- include("../../partials/admin-template.ejs") %>
    <title>Customer Details</title>
    <link rel="stylesheet" href="/admin/customerManagement/view-customer.css" />
  </head>
  <body>
    <%- include("../../partials/alert.ejs") %>

    <!-- Mobile top bar -->
    <div class="mobile-topbar">
      <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Open menu">
        <span class="material-symbols-outlined">menu</span>
      </button>
      <a href="/admin" class="mobile-logo">OtakuVerse</a>
    </div>

    <!-- Sidebar overlay (mobile) -->
    <div class="sidebar-overlay" id="sidebar-overlay"></div>

    <div class="admin-layout">
      <%- include('../../partials/admin-sidebar.ejs') %>

      <main class="main-content">
        <div class="page-inner">

          <!-- Breadcrumb -->
          <div class="breadcrumb">
            <a href="/admin/customer-management?offset=1">Customers</a>
            <span class="material-symbols-outlined">chevron_right</span>
            <span>Customer Details</span>
          </div>

          <!-- Page header -->
          <div class="page-header">
            <h1 class="page-title">Customer Details</h1>
          </div>

          <!-- Customer details card -->
          <% if (typeof customer !== 'undefined' && customer) { %>
            <div class="detail-grid">

              <div class="detail-card">
                <div class="detail-card-header">
                  <span class="material-symbols-outlined">person</span>
                  Profile
                </div>
                <div class="detail-rows">
                  <div class="detail-row">
                    <span class="detail-label">Name</span>
                    <span class="detail-value"><%= customer.customer_name %></span>
                  </div>
                  <div class="detail-row">
                    <span class="detail-label">Email</span>
                    <span class="detail-value"><%= customer.customer_email %></span>
                  </div>
                  <div class="detail-row">
                    <span class="detail-label">Status</span>
                    <span class="detail-value">
                      <span class="status-badge <%= customer.account_status === 'active' ? 'status-active' : 'status-banned' %>">
                        <%= customer.account_status %>
                      </span>
                    </span>
                  </div>
                  <div class="detail-row">
                    <span class="detail-label">Customer ID</span>
                    <span class="detail-value detail-mono"><%= customer._id %></span>
                  </div>
                </div>
              </div>

            </div>
          <% } else { %>
            <div class="empty-state">
              <span class="material-symbols-outlined empty-icon">person_off</span>
              <p>No customer data available.</p>
              <a href="/admin/customer-management?offset=1" class="back-link">Back to Customers</a>
            </div>
          <% } %>

        </div>
      </main>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const mobileBtn = document.getElementById("mobile-menu-btn");
        const sidebarToggle = document.getElementById("sidebar-toggle");
        if (mobileBtn && sidebarToggle) {
          mobileBtn.addEventListener("click", () => sidebarToggle.click());
        }
      });
    </script>
  </body>
</html>
