<%-include("../../partials/admin-template.ejs")%>
    <title>Order Management</title>
    <link rel="stylesheet" href="/admin/orderManagement/order-list.css" />
  </head>
  <body>
    <%- include('../../partials/alert.ejs') %>

    <!-- Mobile top bar -->
    <div class="mobile-topbar">
      <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Open menu">
        <span class="material-symbols-outlined">menu</span>
      </button>
      <a href="/admin" class="mobile-logo">OtakuVerse</a>
    </div>

    <!-- Sidebar overlay (mobile) -->
    <div class="sidebar-overlay" id="sidebar-overlay"></div>

    <div class="admin-layout">
      <%- include('../../partials/admin-sidebar.ejs') %>

      <main class="main-content">
        <div class="page-inner">

          <!-- Page header -->
          <div class="page-header">
            <h1 class="page-title">Orders</h1>
          </div>

          <!-- Table card -->
          <div class="table-card">
            <div class="table-wrapper">
              <table>
                <thead>
                  <tr>
                    <th>Order ID</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Items</th>
                    <th>Amount</th>
                    <th>Payment</th>
                    <th>Status</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody>
                  <% const months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"]; %>
                  <% const paymentLabels = { cod: "Cash on delivery", razorpay: "Razorpay", wallet: "Wallet" }; %>
                  <% if (orders.length === 0) { %>
                    <tr>
                      <td colspan="8" class="empty-row">No orders found.</td>
                    </tr>
                  <% } %>
                  <% orders.forEach(order => { %>
                    <%
                      const orderDate = new Date(order.createdAt);
                      const dateStr = orderDate.getDate() + " " + months[orderDate.getMonth()] + " " + orderDate.getFullYear();
                      const allCancelled = order.order_items.every(i => i.product_status === "cancelled");
                      const anyDelivered = order.order_items.some(i => i.product_status === "delivered");
                      let rowStatus = "active";
                      if (allCancelled) rowStatus = "cancelled";
                      else if (anyDelivered) rowStatus = "delivered";
                    %>
                    <tr class="order-row" data-href="/admin/view-order/<%= order._id %>">
                      <td class="id-col"><%= order._id %></td>
                      <td><%= order.customer_id?.customer_name || 'N/A' %></td>
                      <td class="nowrap"><%= dateStr %></td>
                      <td class="center"><%= order.order_items.length %></td>
                      <td class="nowrap">₹<%= (order.amount || 0).toFixed(2) %></td>
                      <td>
                        <span class="payment-badge payment-<%= order.payment_status %>">
                          <%= order.payment_status %>
                        </span>
                      </td>
                      <td>
                        <span class="status-badge status-<%= rowStatus %>">
                          <%= rowStatus %>
                        </span>
                      </td>
                      <td class="view-col">
                        <a href="/admin/view-order/<%= order._id %>" class="view-link" title="View order">
                          <span class="material-symbols-outlined">chevron_right</span>
                        </a>
                      </td>
                    </tr>
                  <% }) %>
                </tbody>
              </table>
            </div>
            <div class="pagination-wrapper">
              <%- include('../../partials/pagination.ejs') %>
            </div>
          </div>

        </div>
      </main>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        // Mobile sidebar
        const mobileBtn = document.getElementById("mobile-menu-btn");
        const sidebarToggle = document.getElementById("sidebar-toggle");
        if (mobileBtn && sidebarToggle) {
          mobileBtn.addEventListener("click", () => sidebarToggle.click());
        }
        // Clickable rows
        document.querySelectorAll(".order-row").forEach(row => {
          row.addEventListener("click", (e) => {
            if (!e.target.closest("a")) {
              window.location.href = row.dataset.href;
            }
          });
        });
      });
    </script>
  </body>
</html>
