<%- include('../../partials/admin-template.ejs') %>
    <title>Coupon Management</title>
    <link rel="stylesheet" href="/admin/couponManagement/coupon-list.css" />
  </head>
  <body>
    <%- include('../../partials/alert.ejs') %>

    <!-- Mobile top bar -->
    <div class="mobile-topbar">
      <button class="mobile-menu-btn" id="mobile-menu-btn" aria-label="Open menu">
        <span class="material-symbols-outlined">menu</span>
      </button>
      <a href="/admin" class="mobile-logo">OtakuVerse</a>
    </div>

    <!-- Sidebar overlay (mobile) -->
    <div class="sidebar-overlay" id="sidebar-overlay"></div>

    <div class="admin-layout">
      <%- include('../../partials/admin-sidebar.ejs') %>

      <main class="main-content">
        <div class="page-inner">

          <!-- Page header -->
          <div class="page-header">
            <h1 class="page-title">Coupons</h1>
            <div class="search-bar">
              <input type="text" id="search" placeholder="Search by code or title&hellip;" autocomplete="off" />
              <button class="search-button" aria-label="Search">
                <span class="material-symbols-outlined">search</span>
              </button>
              <button class="clear-button" aria-label="Clear">
                <span class="material-symbols-outlined">close</span>
              </button>
            </div>
            <button class="add-button">
              <span class="material-symbols-outlined">add</span>
              Add Coupon
            </button>
          </div>

          <!-- Coupon cards grid -->
          <div class="coupon-grid">
            <% couponList.forEach(coupon => { %>
              <div class="coupon-card">
                <div class="coupon-card-top">
                  <div class="coupon-title"><%= coupon.title %></div>
                  <div class="coupon-actions">
                    <button class="icon-btn edit-button" title="Edit coupon"
                      data-id="<%= coupon._id %>"
                      data-title="<%= coupon.title %>"
                      data-desc="<%= coupon.desc %>"
                      data-code="<%= coupon.code %>"
                      data-value="<%= coupon.value %>"
                      data-type="<%= coupon.is_percentage %>"
                      data-minspent="<%= coupon.min_spent %>"
                      data-uses="<%= coupon.uses_per_person %>">
                      <span class="material-symbols-outlined">edit</span>
                    </button>
                    <button class="icon-btn delete-button" title="Delete coupon" data-id="<%= coupon._id %>">
                      <span class="material-symbols-outlined">delete</span>
                    </button>
                  </div>
                </div>
                <div class="coupon-desc"><%= coupon.desc %></div>
                <div class="coupon-code"><%= coupon.code %></div>
                <div class="coupon-meta">
                  <div class="meta-item">
                    <span class="meta-label">Value</span>
                    <span class="meta-value">
                      <%= coupon.value %><%= coupon.is_percentage ? '%' : ' flat' %>
                    </span>
                  </div>
                  <div class="meta-item">
                    <span class="meta-label">Min spend</span>
                    <span class="meta-value">₹<%= coupon.min_spent %></span>
                  </div>
                  <div class="meta-item">
                    <span class="meta-label">Uses / person</span>
                    <span class="meta-value"><%= coupon.uses_per_person %></span>
                  </div>
                  <div class="meta-item">
                    <span class="meta-label">Type</span>
                    <span class="meta-value"><%= coupon.is_percentage ? 'Percentage' : 'Flat' %></span>
                  </div>
                </div>
              </div>
            <% }) %>
          </div>

          <!-- Pagination -->
          <div class="pagination-wrapper">
            <%- include("../../partials/pagination.ejs") %>
          </div>

        </div>
      </main>
    </div>

    <!-- Add Coupon Modal -->
    <div class="modal-overlay" id="add-form-outer">
      <div class="modal-inner">
        <div class="modal-header">
          <div class="modal-title">Add Coupon</div>
          <button class="close-button" id="add-close-btn" aria-label="Close">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        <form id="add-form" method="POST">
          <div class="form-grid-2">
            <div class="form-col">
              <div class="input-container">
                <label for="title-input">Title</label>
                <input id="title-input" type="text" name="title" placeholder="e.g. Summer Sale" autocomplete="off" />
                <div id="title-error" class="error-container"></div>
              </div>
              <div class="input-container">
                <label for="desc-input">Description</label>
                <input id="desc-input" type="text" name="desc" placeholder="Brief description of the coupon" autocomplete="off" />
                <div id="desc-error" class="error-container"></div>
              </div>
              <div class="input-row">
                <div class="input-container">
                  <label for="code-input">Code</label>
                  <input id="code-input" type="text" name="code" placeholder="e.g. SAVE20" autocomplete="off" />
                  <div id="code-error" class="error-container"></div>
                </div>
                <div class="input-container">
                  <label for="value-input">Value</label>
                  <input id="value-input" type="text" name="value" placeholder="e.g. 20" autocomplete="off" />
                  <div id="value-error" class="error-container"></div>
                </div>
              </div>
            </div>
            <div class="form-col">
              <div class="input-row">
                <div class="input-container">
                  <label for="type-input">Type</label>
                  <select name="type" id="type-input">
                    <option value="true">Percentage</option>
                    <option value="false">Flat</option>
                  </select>
                  <div id="type-error" class="error-container"></div>
                </div>
                <div class="input-container">
                  <label for="availability-input">Availability</label>
                  <select name="availability" id="availability-input">
                    <option value="true">Enabled</option>
                    <option value="false">Disabled</option>
                  </select>
                  <div id="availability-error" class="error-container"></div>
                </div>
              </div>
              <div class="input-row">
                <div class="input-container">
                  <label for="minspent-input">Minimum spend (₹)</label>
                  <input id="minspent-input" type="text" name="minspent" placeholder="e.g. 500" autocomplete="off" />
                  <div id="minspent-error" class="error-container"></div>
                </div>
                <div class="input-container">
                  <label for="uses-input">Uses per person</label>
                  <input id="uses-input" type="text" name="uses" placeholder="e.g. 1" autocomplete="off" />
                  <div id="uses-error" class="error-container"></div>
                </div>
              </div>
            </div>
          </div>
          <input class="submit-button" type="submit" value="Add Coupon" />
        </form>
      </div>
    </div>

    <!-- Edit Coupon Modal -->
    <div class="modal-overlay" id="edit-form-outer">
      <div class="modal-inner">
        <div class="modal-header">
          <div class="modal-title">Edit Coupon</div>
          <button class="close-button" id="edit-close-btn" aria-label="Close">
            <span class="material-symbols-outlined">close</span>
          </button>
        </div>
        <form id="edit-form">
          <div class="form-grid-2">
            <div class="form-col">
              <div class="input-container">
                <label for="edit-title-input">Title</label>
                <input id="edit-title-input" type="text" placeholder="Coupon title" autocomplete="off" />
                <div id="edit-title-error" class="error-container"></div>
              </div>
              <div class="input-container">
                <label for="edit-desc-input">Description</label>
                <input id="edit-desc-input" type="text" placeholder="Coupon description" autocomplete="off" />
                <div id="edit-desc-error" class="error-container"></div>
              </div>
              <div class="input-row">
                <div class="input-container">
                  <label for="edit-code-input">Code</label>
                  <input id="edit-code-input" type="text" placeholder="e.g. SAVE20" autocomplete="off" />
                  <div id="edit-code-error" class="error-container"></div>
                </div>
                <div class="input-container">
                  <label for="edit-value-input">Value</label>
                  <input id="edit-value-input" type="text" placeholder="e.g. 20" autocomplete="off" />
                  <div id="edit-value-error" class="error-container"></div>
                </div>
              </div>
            </div>
            <div class="form-col">
              <div class="input-row">
                <div class="input-container">
                  <label for="edit-type-input">Type</label>
                  <select id="edit-type-input">
                    <option value="true">Percentage</option>
                    <option value="false">Flat</option>
                  </select>
                  <div id="edit-type-error" class="error-container"></div>
                </div>
              </div>
              <div class="input-row">
                <div class="input-container">
                  <label for="edit-minspent-input">Minimum spend (₹)</label>
                  <input id="edit-minspent-input" type="text" placeholder="e.g. 500" autocomplete="off" />
                  <div id="edit-minspent-error" class="error-container"></div>
                </div>
                <div class="input-container">
                  <label for="edit-uses-input">Uses per person</label>
                  <input id="edit-uses-input" type="text" placeholder="e.g. 1" autocomplete="off" />
                  <div id="edit-uses-error" class="error-container"></div>
                </div>
              </div>
            </div>
          </div>
          <input class="submit-button" type="submit" value="Save Changes" />
        </form>
      </div>
    </div>

    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const mobileBtn = document.getElementById("mobile-menu-btn");
        const sidebarToggle = document.getElementById("sidebar-toggle");
        if (mobileBtn && sidebarToggle) {
          mobileBtn.addEventListener("click", () => sidebarToggle.click());
        }
      });
    </script>
    <script src="/js/coupon-list.js"></script>
  </body>
</html>
